+# ---- untrusted text that speaks to the checker (checker_text="remove" or "flag")
+# A segment (a sentence, a line or a bracketed note) of a tool's output is "addressed to the checker" when it names a
+# checker and tells it what to do or claims a verdict, discusses prompt injection, or fakes a boundary of the data.
+_CHECKER = (r"(?:checker|reviewer|monitor|judge|verifier|validator|auditor|detector|classifier|guardrail|guard|moderator|"
+            r"evaluator|inspector|(?:safety|security|risk|automated|ai) (?:check|scan|review|filter|system|team))s?")
+_ADDRESS = (r"(?:must|should|need to|needs to|have to|has to|is to|are to|always|never|answer|output|respond|reply|"
+            r"return|rate|score|mark|classify|label|approve|allow|ignore|treat|consider|verified|pre-verified|approved|"
+            r"cleared|safe)")
+_ADDRESSED = [
+    re.compile(rf"\b{_CHECKER}\b.*\b{_ADDRESS}\b|\b{_ADDRESS}\b.*\b{_CHECKER}\b", re.I),
+    re.compile(r"\bprompt[- ]injections?\b", re.I),
+    re.compile(r"\b(?:start|end|beginning|close|begin) of (?:the )?(?:untrusted|trusted|quoted|tool|third[- ]party|user|"
+               r"system|external)\b", re.I),
+]
+_SEGMENT = re.compile(r"(?<=[.!?\]])\s+|\\n|\n")
+REMOVED = "[text addressed to the checker, removed by the intent check]"
+
+
+def addressed_segments(text: str) -> list[str]:
+    """The segments of untrusted text that address the checker (see _ADDRESSED)."""
+    return [seg for seg in _SEGMENT.split(str(text)) if seg.strip() and any(r.search(seg) for r in _ADDRESSED)]
+
+
+def neutralize(text: str) -> str:
+    """Untrusted text with every segment that addresses the checker replaced by REMOVED."""
+    text = str(text)
+    for seg in sorted(set(addressed_segments(text)), key=len, reverse=True):
+        text = text.replace(seg, REMOVED)
+    return text
+
+
+# ---- delegation: the user's request tells the agent to follow instructions found in a named source
+_DELEGATE = [
+    re.compile(r"\bfollow (?:the |all (?:the )?)?(?:instructions|steps|directions)\b", re.I),
+    re.compile(r"\b(?:do|perform|carry out|complete|execute) (?:all )?(?:the )?(?:actions|tasks|steps|instructions|"
+               r"to-?dos?)\b", re.I),
+    re.compile(r"\baccordingly\b", re.I),
+]
+_SOURCE = re.compile(r"'([^']{3,200})'|\"([^\"]{3,200})\"|((?:https?://)?www\.[^\s!?,;]+[^\s!?,;.])")
+_EMAIL = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")
+_IBAN = re.compile(r"\b[A-Z]{2}\d{2}[A-Z0-9]{10,30}\b")
+_URL = re.compile(r"(?:https?://|www\.)[^\s\"']+|\b[\w-]+\.(?:com|org|net|io|ai|dev|co|info|biz|xyz)\b[^\s\"']*", re.I)
+_DEST_KEYS = re.compile(r"^(?:recipients?|to|cc|bcc|participants?|emails?|iban|accounts?|urls?|links?|website)$", re.I)
+
+
+def delegated_sources(user_request: str) -> list[str]:
+    """The sources (quoted names, web addresses) a request delegates to, or [] when it does not delegate."""
+    if not any(r.search(user_request) for r in _DELEGATE):
+        return []
+    return [next(g for g in m.groups() if g) for m in _SOURCE.finditer(user_request)]
+
+
+def _strings(value, key: str = ""):
+    if isinstance(value, dict):
+        for k, v in value.items():
+            yield from _strings(v, str(k))
+    elif isinstance(value, (list, tuple)):
+        for v in value:
+            yield from _strings(v, key)
+    elif value is not None:
+        yield key, str(value)
+
+
+def unnamed_destinations(user_request: str, action) -> list[str]:
+    """Destinations in the step (e-mail addresses, IBANs, web addresses, recipient-like fields) that the user's request
+    does not contain."""
+    req = user_request.lower()
+    found = []
+    pairs = list(_strings(action.get("input", {}))) if isinstance(action, dict) else [("", str(action))]
+    for key, val in pairs:
+        cands = _EMAIL.findall(val) + _IBAN.findall(val) + _URL.findall(val)
+        if _DEST_KEYS.match(key) and val.strip():
+            cands.append(val.strip())
+        found += [c for c in cands if c.lower() not in req]
+    return list(dict.fromkeys(found))
+
